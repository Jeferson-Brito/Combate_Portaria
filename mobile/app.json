{
  "expo": {
    "name": "Combate Portaria",
    "slug": "combate-portaria",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F203D"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.grupocombate.portaria",
      "infoPlist": {
        "NSCameraUsageDescription": "O aplicativo necessita de acesso à câmera para fotografar visitantes na portaria."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F203D"
      },
      "package": "com.grupocombate.portaria",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Permitir que o Combate Portaria tire fotos de visitantes."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0F203D"
        }
      ]
    ]
  }
}
